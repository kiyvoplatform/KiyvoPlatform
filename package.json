{
  "name": "kiyvo-desktop",
  "version": "1.8.0",
  "description": "Kiyvo Desktop — create, stream, watch and connect.",
  "main": "src/main.js",
  "author": "Kiyvo",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "cross-env KIYVO_DEVTOOLS=1 electron .",
    "pack": "electron-builder --dir",
    "build:win": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable",
    "release:win": "electron-builder --win nsis --publish always",
    "build:linux": "electron-builder --linux AppImage",
    "build:mac": "electron-builder --mac dmg"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "cross-env": "7.0.3",
    "electron": "28.3.3",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "world.royakgames.kiyvo",
    "productName": "Kiyvo",
    "executableName": "Kiyvo",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "artifactName": "Kiyvo-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "kiyvoplatform",
        "repo": "KiyvoPlatform",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "publisherName": "Kiyvo"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kiyvo",
      "uninstallDisplayName": "Kiyvo"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "AudioVideo;Network"
    },
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.entertainment"
    }
  }
}
