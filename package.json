{
  "name": "kiyvo-desktop",
  "version": "1.8.0",
  "description": "Kiyvo desktop client with integrated settings HUD, custom app chrome, in-app updates and errors, broadcasting, and secure media capture.",
  "main": "src/main.js",
  "author": "Kiyvo",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "cross-env KIYVO_DEVTOOLS=1 electron .",
    "pack": "electron-builder --dir",
    "build:win": "electron-builder --win nsis portable",
    "build:linux": "electron-builder --linux AppImage",
    "build:mac": "electron-builder --mac dmg"
  },
  "dependencies": {},
  "devDependencies": {
    "cross-env": "7.0.3",
    "electron": "28.3.3",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "world.royakgames.kiyvo",
    "productName": "Kiyvo",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kiyvo"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "AudioVideo;Network"
    },
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.entertainment"
    }
  }
}